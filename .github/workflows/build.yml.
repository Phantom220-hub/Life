          package com.fitboss.app

          import android.content.Context
          import android.graphics.Canvas
          import android.graphics.Color
          import android.graphics.Paint
          import android.view.View
          import com.google.mediapipe.tasks.components.containers.NormalizedLandmark

          class SkeletonView(context: Context) : View(context) {
              var points: List<NormalizedLandmark>? = null
              var mirror = false

              private val line = Paint(Paint.ANTI_ALIAS_FLAG).apply {
                  color = Color.GREEN
                  strokeWidth = 4f * resources.displayMetrics.density
              }
              private val dot = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.YELLOW }

              private val links = listOf(
                  11 to 12, 11 to 13, 13 to 15, 12 to 14, 14 to 16,
                  11 to 23, 12 to 24, 23 to 24, 23 to 25, 25 to 27, 24 to 26, 26 to 28
              )
              private val joints = intArrayOf(0, 11, 12, 13, 14, 15, 16, 23, 24, 25, 26, 27, 28)

              private fun px(x: Float, w: Float): Float = if (mirror) (1f - x) * w else x * w

              override fun onDraw(canvas: Canvas) {
                  val p = points ?: return
                  if (p.size < 29) return
                  val w = width.toFloat()
                  val h = height.toFloat()
                  for ((a, b) in links) {
                      val la = p[a]
                      val lb = p[b]
                      if (la.visibility().orElse(0f) < 0.4f || lb.visibility().orElse(0f) < 0.4f) continue
                      canvas.drawLine(px(la.x(), w), la.y() * h, px(lb.x(), w), lb.y() * h, line)
                  }
                  val r = 4f * resources.displayMetrics.density
                  for (i in joints) {
                      val l = p[i]
                      if (l.visibility().orElse(0f) < 0.4f) continue
                      canvas.drawCircle(px(l.x(), w), l.y() * h, r, dot)
                  }
              }
          }
