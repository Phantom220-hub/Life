          package com.fitboss.app

          import com.google.mediapipe.tasks.components.containers.NormalizedLandmark
          import kotlin.math.abs
          import kotlin.math.atan2

          /** Считает повторения по точкам тела. Один счётчик на одно упражнение. */
          class RepCounter(val exercise: Exercise) {
              var status: String = "Встань в кадр"
                  private set

              private var phaseDown = false
              private var smooth = -1.0
              private var pushStart = 0L
              private var w = 1f
              private var h = 1f

              private fun vis(l: NormalizedLandmark): Float = l.visibility().orElse(0f)

              private fun pt(l: NormalizedLandmark): DoubleArray =
                  doubleArrayOf((l.x() * w).toDouble(), (l.y() * h).toDouble())

              private fun angle(a: DoubleArray, b: DoubleArray, c: DoubleArray): Double {
                  val a1 = atan2(a[1] - b[1], a[0] - b[0])
                  val a2 = atan2(c[1] - b[1], c[0] - b[0])
                  var deg = Math.toDegrees(abs(a1 - a2))
                  if (deg > 180.0) deg = 360.0 - deg
                  return deg
              }

              private fun smoothed(v: Double): Double {
                  smooth = if (smooth < 0) v else smooth * 0.5 + v * 0.5
                  return smooth
              }

              private fun pick(lm: List<NormalizedLandmark>, left: IntArray, right: IntArray): IntArray? {
                  val lv = left.minOf { vis(lm[it]) }
                  val rv = right.minOf { vis(lm[it]) }
                  val best = if (lv >= rv) left else right
                  return if (maxOf(lv, rv) >= 0.4f) best else null
              }

              private fun hidden(): Int {
                  status = "Тебя не видно: встань в кадр целиком"
                  return 0
              }

              /** Возвращает 1, если засчитано новое повторение, иначе 0. */
              fun update(lm: List<NormalizedLandmark>, width: Float, height: Float, now: Long): Int {
                  w = width
                  h = height
                  if (lm.size < 29) return hidden()
                  return when (exercise) {
                      Exercise.PUSHUP, Exercise.CLAP -> pushup(lm, now)
                      Exercise.PULLUP -> pullup(lm)
                      Exercise.SQUAT -> squat(lm)
                      Exercise.SITUP -> situp(lm)
                  }
              }

              private fun pushup(lm: List<NormalizedLandmark>, now: Long): Int {
                  val s = pick(lm, intArrayOf(11, 13, 15, 23), intArrayOf(12, 14, 16, 24)) ?: return hidden()
                  val sh = pt(lm[s[0]])
                  val el = pt(lm[s[1]])
                  val wr = pt(lm[s[2]])
                  val hp = pt(lm[s[3]])
                  val horizontal = abs(sh[0] - hp[0]) > abs(sh[1] - hp[1])
                  if (!horizontal) {
                      status = "Прими упор лёжа (тело горизонтально)"
                      return 0
                  }
                  val a = smoothed(angle(sh, el, wr))
                  status = "Угол локтя: ${a.toInt()}°"
                  if (a < 95) {
                      phaseDown = true
                      pushStart = 0L
                  } else if (phaseDown) {
                      if (a > 110 && pushStart == 0L) pushStart = now
                      if (a > 155) {
                          val dur = now - pushStart
                          phaseDown = false
                          pushStart = 0L
                          if (exercise == Exercise.CLAP) {
                              if (dur in 1L..400L) return 1
                              status = "Оттолкнись резче для хлопка!"
                              return 0
                          }
                          return 1
                      }
                  }
                  return 0
              }

              private fun pullup(lm: List<NormalizedLandmark>): Int {
                  val ids = intArrayOf(0, 11, 12, 13, 14, 15, 16)
                  if (ids.any { vis(lm[it]) < 0.4f }) return hidden()
                  val angL = angle(pt(lm[11]), pt(lm[13]), pt(lm[15]))
                  val angR = angle(pt(lm[12]), pt(lm[14]), pt(lm[16]))
                  val elbow = smoothed((angL + angR) / 2.0)
                  val wristY = (lm[15].y() + lm[16].y()) / 2f
                  val shoulderY = (lm[11].y() + lm[12].y()) / 2f
                  status = "Локти: ${elbow.toInt()}°"
                  if (elbow > 145 && wristY < shoulderY) phaseDown = true
                  if (phaseDown && lm[0].y() < wristY && elbow < 115) {
                      phaseDown = false
                      return 1
                  }
                  return 0
              }

              private fun squat(lm: List<NormalizedLandmark>): Int {
                  val s = pick(lm, intArrayOf(23, 25, 27), intArrayOf(24, 26, 28)) ?: return hidden()
                  val a = smoothed(angle(pt(lm[s[0]]), pt(lm[s[1]]), pt(lm[s[2]])))
                  status = "Колени: ${a.toInt()}°"
                  if (a < 100) {
                      phaseDown = true
                  } else if (a > 160 && phaseDown) {
                      phaseDown = false
                      return 1
                  }
                  return 0
              }

              private fun situp(lm: List<NormalizedLandmark>): Int {
                  val s = pick(lm, intArrayOf(11, 23, 25), intArrayOf(12, 24, 26)) ?: return hidden()
                  val a = smoothed(angle(pt(lm[s[0]]), pt(lm[s[1]]), pt(lm[s[2]])))
                  status = "Корпус: ${a.toInt()}°"
                  if (a > 125) {
                      phaseDown = true
                  } else if (a < 85 && phaseDown) {
                      phaseDown = false
                      return 1
                  }
                  return 0
              }
          }
