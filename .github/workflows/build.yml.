          package com.fitboss.app

          import android.content.Context
          import java.time.LocalDate

          object Prefs {
              const val DAILY_GOAL = 50

              private val ranks = listOf(
                  0 to "Новичок",
                  100 to "Боец",
                  500 to "Воин",
                  1500 to "Ветеран",
                  5000 to "Легенда"
              )

              private fun sp(c: Context) = c.getSharedPreferences("fitboss", Context.MODE_PRIVATE)
              private fun today(): Long = LocalDate.now().toEpochDay()

              fun addReps(c: Context, n: Int) {
                  val s = sp(c)
                  val t = today()
                  val last = s.getLong("lastDay", -1L)
                  var streak = s.getInt("streak", 0)
                  var todayReps = if (last == t) s.getInt("todayReps", 0) else 0
                  if (last != t) {
                      streak = if (last == t - 1) streak + 1 else 1
                  }
                  todayReps += n
                  s.edit()
                      .putLong("lastDay", t)
                      .putInt("streak", streak)
                      .putInt("todayReps", todayReps)
                      .putInt("total", s.getInt("total", 0) + n)
                      .apply()
              }

              fun streak(c: Context): Int {
                  val s = sp(c)
                  val last = s.getLong("lastDay", -1L)
                  val t = today()
                  return if (last == t || last == t - 1) s.getInt("streak", 0) else 0
              }

              fun todayReps(c: Context): Int {
                  val s = sp(c)
                  return if (s.getLong("lastDay", -1L) == today()) s.getInt("todayReps", 0) else 0
              }

              fun total(c: Context): Int = sp(c).getInt("total", 0)

              fun best(c: Context): Int = sp(c).getInt("bestRound", 0)

              fun setBest(c: Context, round: Int) {
                  if (round > best(c)) sp(c).edit().putInt("bestRound", round).apply()
              }

              /** Возвращает звание и сколько всего повторений нужно для следующего (0 если максимум). */
              fun rank(total: Int): Pair<String, Int> {
                  var name = ranks[0].second
                  var next = 0
                  for (i in ranks.indices) {
                      if (total >= ranks[i].first) {
                          name = ranks[i].second
                          next = if (i + 1 < ranks.size) ranks[i + 1].first else 0
                      }
                  }
                  return name to next
              }
          }
